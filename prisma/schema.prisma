generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("staff") // admin, staff
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Customer {
  id         Int      @id @default(autoincrement())
  customerId String   @unique @map("customer_id")
  name       String
  nic        String?  @unique
  phone      String?
  address    String?
  type       String   @default("regular") // regular, non-regular
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  creditPurchases CreditPurchase[]
  teaCollections  TeaCollection[]
  monthlyPayments MonthlyPayment[]

  @@map("customers")
}

model Lorry {
  id          Int      @id @default(autoincrement())
  lorryNumber String   @unique @map("lorry_number")
  capacity    Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  drivers           Driver[]
  teaCollections    TeaCollection[]
  lorryValidations  LorryValidation[]
  driverSessions    DriverSession[]
  factoryDeliveries FactoryDelivery[]

  @@map("lorries")
}

model Driver {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  nic       String?  @unique
  lorryId   Int?     @map("lorry_id")
  active    Boolean  @default(true)
  pin       String?
  createdAt DateTime @default(now()) @map("created_at")

  lorry             Lorry?             @relation(fields: [lorryId], references: [id])
  teaCollections    TeaCollection[]
  driverCommissions DriverCommission[]
  sessions          DriverSession[]
  factoryDeliveries FactoryDelivery[]

  @@map("drivers")
}

model Fertiliser {
  id           Int      @id @default(autoincrement())
  name         String
  pricePerUnit Float    @map("price_per_unit")
  weightPerBag Float?   @map("weight_per_bag")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  creditPurchases CreditPurchase[]

  @@map("fertilisers")
}

model CreditPurchase {
  id               Int      @id @default(autoincrement())
  customerId       Int      @map("customer_id")
  itemType         String   @map("item_type") // grocery, fertiliser
  fertiliserId     Int?     @map("fertiliser_id")
  description      String?
  quantity         Float    @default(1)
  unitPrice        Float    @map("unit_price")
  totalCost        Float    @map("total_cost")
  purchaseDate     DateTime @default(now()) @map("purchase_date")
  month            Int
  year             Int
  settled          Boolean  @default(false)
  monthlyPaymentId Int?     @map("monthly_payment_id")
  createdAt        DateTime @default(now()) @map("created_at")

  customer       Customer        @relation(fields: [customerId], references: [id])
  fertiliser     Fertiliser?     @relation(fields: [fertiliserId], references: [id])
  monthlyPayment MonthlyPayment? @relation(fields: [monthlyPaymentId], references: [id])

  @@index([customerId, settled])
  @@index([year, month])
  @@index([purchaseDate])
  @@map("credit_purchases")
}

model TeaCollection {
  id                  Int       @id @default(autoincrement())
  customerId          Int       @map("customer_id")
  driverId            Int?      @map("driver_id")
  lorryId             Int?      @map("lorry_id")
  kilosByDriver       Float     @map("kilos_by_driver")
  waterDeduction      Float     @default(0) @map("water_deduction") // manual kg deduction by rider
  packagingDeduction  Float     @default(0) @map("packaging_deduction") // manual kg deduction for crates/bags
  kilosValidated      Float?    @map("kilos_validated")
  instantPaid         Boolean   @default(false) @map("instant_paid")
  instantPaidAt       DateTime? @map("instant_paid_at")
  // What was actually paid for an instant cash collection (null for payments made before these were saved)
  instantPricePerKilo Float?    @map("instant_price_per_kilo")
  instantGrossPay     Float?    @map("instant_gross_pay")
  instantTransport    Float?    @map("instant_transport")
  instantStamp        Float?    @map("instant_stamp")
  instantOther        Float?    @map("instant_other")
  instantNetPay       Float?    @map("instant_net_pay")
  monthlyPaid         Boolean   @default(false) @map("monthly_paid")
  monthlyPaymentId    Int?      @map("monthly_payment_id")
  // Driver commission this collection is counted in (null = not yet in any commission)
  driverCommissionId  Int?      @map("driver_commission_id")
  waterScore          Int       @default(0) @map("water_score") // DEPRECATED - kept for old data
  collectionDate      DateTime  @map("collection_date")
  month               Int
  year                Int
  createdAt           DateTime  @default(now()) @map("created_at")

  customer         Customer          @relation(fields: [customerId], references: [id])
  driver           Driver?           @relation(fields: [driverId], references: [id])
  lorry            Lorry?            @relation(fields: [lorryId], references: [id])
  monthlyPayment   MonthlyPayment?   @relation(fields: [monthlyPaymentId], references: [id])
  driverCommission DriverCommission? @relation(fields: [driverCommissionId], references: [id], onDelete: SetNull)

  @@index([customerId, collectionDate])
  @@index([driverCommissionId])
  @@index([collectionDate])
  @@index([lorryId, collectionDate])
  @@index([driverId, collectionDate])
  @@index([year, month])
  @@map("tea_collections")
}

model LorryValidation {
  id                  Int      @id @default(autoincrement())
  lorryId             Int?     @map("lorry_id")
  validationDate      DateTime @map("validation_date")
  totalGrossKilos     Float    @default(0) @map("total_gross_kilos") // sum of kilosByDriver (before deduction)
  totalDriverKilos    Float    @map("total_driver_kilos") // sum of net kilos (after deduction)
  lorryScaleKilos     Float    @default(0) @map("lorry_scale_kilos") // actual lorry scale reading
  totalWarehouseKilos Float    @map("total_warehouse_kilos") // kept for compat
  lorryCumulativeDiff Float    @default(0) @map("lorry_cumulative_diff") // lorryScale - cumulativeNet
  weightLoss          Float    @map("weight_loss") // kept for compat
  collectionsCount    Int      @map("collections_count")
  createdAt           DateTime @default(now()) @map("created_at")

  lorry Lorry? @relation(fields: [lorryId], references: [id])

  @@unique([lorryId, validationDate])
  @@map("lorry_validations")
}

model MonthlyPayment {
  id                   Int       @id @default(autoincrement())
  customerId           Int       @map("customer_id")
  month                Int
  year                 Int
  totalKilos           Float     @map("total_kilos")
  pricePerKilo         Float     @map("price_per_kilo")
  grossPayment         Float     @map("gross_payment")
  groceryDeduction     Float     @default(0) @map("grocery_deduction")
  fertiliserDeduction  Float     @default(0) @map("fertiliser_deduction")
  cashAdvanceDeduction Float     @default(0) @map("cash_advance_deduction")
  transportCostPerKilo Float     @default(0) @map("transport_cost_per_kilo")
  transportCostTotal   Float     @default(0) @map("transport_cost_total")
  stampCostPerKilo     Float     @default(0) @map("stamp_cost_per_kilo")
  stampCostTotal       Float     @default(0) @map("stamp_cost_total")
  otherDeductionPct    Float     @default(0) @map("other_deduction_pct") // DEPRECATED - kept for old data
  otherDeductionAmt    Float     @default(0) @map("other_deduction_amt") // DEPRECATED - kept for old data
  netPayment           Float     @map("net_payment")
  cashReceived         Float     @default(0) @map("cash_received")
  settledCreditIds     Json?     @map("settled_credit_ids")
  paid                 Boolean   @default(false)
  paidAt               DateTime? @map("paid_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  customer           Customer         @relation(fields: [customerId], references: [id])
  settledCredits     CreditPurchase[]
  settledCollections TeaCollection[]

  @@unique([customerId, month, year])
  @@index([year, month])
  @@map("monthly_payments")
}

model DriverCommission {
  id               Int       @id @default(autoincrement())
  driverId         Int       @map("driver_id")
  month            Int
  year             Int
  totalKilos       Float     @map("total_kilos")
  pricePerKilo     Float     @map("price_per_kilo")
  commissionRate   Float     @default(5) @map("commission_rate")
  commissionAmount Float     @map("commission_amount")
  // collection = tea collected from customers; delivery = tea taken to factories in our lorry
  type             String    @default("collection")
  paid             Boolean   @default(false)
  paidAt           DateTime? @map("paid_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  driver      Driver            @relation(fields: [driverId], references: [id])
  collections TeaCollection[]
  deliveries  FactoryDelivery[]

  // month/year = commission period: 26th of previous month to 25th of this month
  @@unique([driverId, month, year, type])
  @@index([year, month])
  @@map("driver_commissions")
}

model Settings {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("settings")
}

// One-time login / confirmation codes. key is "driver:<last 9 digits of phone>" or "clear-data"
model OtpCode {
  key       String   @id
  codeHash  String   @map("code_hash")
  driverId  Int?     @map("driver_id")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_codes")
}

model DriverSession {
  id               Int       @id @default(autoincrement())
  driverId         Int       @map("driver_id")
  lorryId          Int?      @map("lorry_id")
  sessionDate      DateTime  @map("session_date")
  startedAt        DateTime  @default(now()) @map("started_at")
  stoppedAt        DateTime? @map("stopped_at")
  isActive         Boolean   @default(true) @map("is_active")
  collectionsCount Int       @default(0) @map("collections_count")
  totalKilos       Float     @default(0) @map("total_kilos")
  createdAt        DateTime  @default(now()) @map("created_at")

  driver Driver @relation(fields: [driverId], references: [id])
  lorry  Lorry? @relation(fields: [lorryId], references: [id])

  @@unique([driverId, sessionDate])
  @@index([sessionDate])
  @@map("driver_sessions")
}

// Factories the tea is sold to. Each has its own deduction names (as printed on their card).
model Factory {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  deductionTypes Json     @default("[]") @map("deduction_types") // e.g. ["Water", "Crates", "Mature leaves"]
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  deliveries FactoryDelivery[]

  @@map("factories")
}

// One load of tea handed over to a factory, and (later) what the factory card says about it.
model FactoryDelivery {
  id           Int      @id @default(autoincrement())
  deliveryDate DateTime @map("delivery_date") // date only (UTC midnight)
  factoryId    Int      @map("factory_id")

  // Transport: "ours" (our lorry + driver, driver earns delivery commission) or "factory" (their own lorry)
  transport        String  @default("ours")
  lorryId          Int?    @map("lorry_id")
  driverId         Int?    @map("driver_id")
  factoryVehicleNo String? @map("factory_vehicle_no")

  // Weights at our side
  handedOverKg Float   @map("handed_over_kg") // scale reading, incl. factory gunny bags if any
  gunnyBags    Boolean @default(false) @map("gunny_bags")
  gunnyBagKg   Float   @default(0) @map("gunny_bag_kg") // total weight of the factory's bags
  teaSentKg    Float   @map("tea_sent_kg") // handedOverKg - gunnyBagKg

  // Delivery commission (our lorry only): rate at the time of recording
  commissionPerKg    Float? @map("commission_per_kg")
  driverCommissionId Int?   @map("driver_commission_id")

  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  // Factory card (filled in later)
  cardReceivedKg     Float?    @map("card_received_kg")
  cardDeductions     Json?     @map("card_deductions") // { "Water": 10, "Crates": 5 }
  cardTotalDeduction Float?    @map("card_total_deduction")
  cardAcceptedKg     Float?    @map("card_accepted_kg")
  cardEnteredAt      DateTime? @map("card_entered_at")

  // Admin dismissed the flags for this delivery (e.g. rain); not used for learning "normal"
  flagDismissedReason String?   @map("flag_dismissed_reason")
  flagDismissedNote   String?   @map("flag_dismissed_note")
  flagDismissedBy     String?   @map("flag_dismissed_by")
  flagDismissedAt     DateTime? @map("flag_dismissed_at")

  factory          Factory           @relation(fields: [factoryId], references: [id])
  lorry            Lorry?            @relation(fields: [lorryId], references: [id])
  driver           Driver?           @relation(fields: [driverId], references: [id])
  driverCommission DriverCommission? @relation(fields: [driverCommissionId], references: [id], onDelete: SetNull)

  @@index([deliveryDate])
  @@index([factoryId, deliveryDate])
  @@index([driverCommissionId])
  @@map("factory_deliveries")
}
